{
  "name": "napright-tooling",
  "private": true,
  "scripts": {
    "format": "prettier --write package.json package-lock.json .prettierrc.json \"docs/**/*.md\" \"probe/**/*.mc\" \"probe/**/*.xml\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check package.json package-lock.json .prettierrc.json \"docs/**/*.md\" \"probe/**/*.mc\" \"probe/**/*.xml\" --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "@markw65/prettier-plugin-monkeyc": "1.0.69",
    "@prettier/plugin-xml": "3.4.2",
    "prettier": "3.9.9"
  }
}
